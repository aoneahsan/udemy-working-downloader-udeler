{
	"name": "udemyd1",
	"version": "2.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/aoneahsan/udemyd1.git"
	},
	"description": "A cross platform (Windows, Mac, Linux) desktop application for downloading non-DRM Udemy Courses you are enrolled in.",
	"main": "index.js",
	"scripts": {
		"start": "electron .",
		"postinstall": "electron-builder install-app-deps",
		"build": "electron-builder -wml",
		"build-win": "electron-builder -w",
		"build-mac": "electron-builder -m",
		"build-linux": "electron-builder -l",
		"dist": "electron-builder"
	},
	"build": {
		"appId": "com.zaions.udeler-clone",
		"productName": "Udeler",
		"directories": {
			"buildResources": "assets/images/build"
		},
		"win": {
			"target": [
				"nsis"
			]
		},
		"mac": {
			"target": [
				"dmg"
			],
			"category": "public.app-category.utilities"
		},
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Utility"
		}
	},
	"author": {
		"name": "Ahsan Mahmood",
		"email": "aoneahsan@gmail.com",
		"url": "https://github.com/aoneahsan"
	},
	"license": "ISC",
	"devDependencies": {
		"electron": "^42.3.3",
		"electron-builder": "^26.8.2"
	},
	"dependencies": {
		"@electron/remote": "^2.1.3",
		"dialogs": "2.0.1",
		"download": "8.0.0",
		"fs-extra": "^11.3.5",
		"jquery": "^3.7.1",
		"mt-files-downloader": "git+https://github.com/FaisalUmair/mt-files-downloader-wrapper.git#7a0b18b3c8a52403bb5e3de25c9c32731bc2cc72",
		"node-vtt-to-srt": "git+https://github.com/riazXrazor/vtt-to-srt.git#3fb9276e7fe4830279210b57fc4e35b7e07b0752",
		"sanitize-filename": "^1.6.4"
	}
}
